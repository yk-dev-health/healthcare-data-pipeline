PROJECT_ID=healthcare-pipeline-yk-01
TOPIC_ID=healthcare-events
SUBSCRIPTION_ID=healthcare-sub
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_DB=0
REDIS_URL=redis://localhost:6379/0
GOOGLE_APPLICATION_CREDENTIALS=/secrets/gcp-key.json
#PUBSUB_EMULATOR_HOST=localhost:8085

# GDPR Compliance Configuration
# Principle 3: Data Minimization
PATIENT_HASH_SALT=your-secure-production-salt-here

# Principle 5: Storage Limitation (in seconds)
SENSITIVE_DATA_TTL=3600           # 1 hour for processing
PROCESSED_EVENT_TTL=604800        # 7 days for analytics
AUDIT_LOG_TTL=7776000             # 90 days for compliance

# Principle 7: Accountability
LOG_LEVEL=INFO
AUDIT_LOG_DIR=./data/logs
DICOM_DATA_DIR=./data
DICOM_OUTPUT_PATH=./data/processed_dicom_events.jsonl
DICOM_AUDIT_PATH=./data/audit_log.jsonl

# Celery Configuration
CELERY_TASK_ALWAYS_EAGER=False

# API Configuration
API_HOST=0.0.0.0
API_PORT=8000
API_RELOAD=True
