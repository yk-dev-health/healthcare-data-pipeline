# Deployment environment. `production` turns on the startup safety checks in
# common/config.py::Settings.validate_for_runtime (the service refuses to boot
# with a default salt, PHI-persisting quarantine, or fail-open idempotency).
APP_ENV=development

PROJECT_ID=healthcare-pipeline-yk-01
TOPIC_ID=healthcare-events
SUBSCRIPTION_ID=healthcare-sub
GOOGLE_APPLICATION_CREDENTIALS=/secrets/gcp-key.json
#PUBSUB_EMULATOR_HOST=localhost:8085

# Publishing is opt-in. Defaults to on only when credentials or an emulator
# host are present, so tests and a bare `uvicorn` never reach for GCP.
PUBSUB_ENABLED=true
PUBSUB_PUBLISH_TIMEOUT=30
# Should mirror the subscription's dead-letter maxDeliveryAttempts. After this
# many attempts a repeatedly-failing message is quarantined instead of looping.
PUBSUB_MAX_DELIVERY_ATTEMPTS=5
# Streaming-pull flow control: never lease more work than can be finished
# inside the ack deadline.
PUBSUB_MAX_OUTSTANDING_MESSAGES=100

# -----------------------------
# Redis
# -----------------------------
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_DB=0
REDIS_URL=redis://localhost:6379/0
# Explicit socket bounds. Without these a dead Redis blocks each call for the
# OS-level TCP timeout (~50 s observed on Windows).
REDIS_CONNECT_TIMEOUT=0.5
REDIS_SOCKET_TIMEOUT=1.0
# Circuit breaker: after a failure, stop dialling for this long so an outage
# costs a constant per call instead of a full timeout each.
REDIS_RECONNECT_COOLDOWN=5

# -----------------------------
# Idempotency (at-least-once delivery -> duplicate suppression)
# -----------------------------
IDEMPOTENCY_NAMESPACE=dicom
# Must exceed p99 processing time; a shorter lease lets a second worker start
# the same study while the first is still running.
IDEMPOTENCY_LEASE_TTL=300
# Must exceed the maximum Pub/Sub redelivery window, or a late redelivery is
# reprocessed. Enforced by validate_for_runtime().
IDEMPOTENCY_COMPLETED_TTL=86400
# closed = refuse to process when the dedup store is down (no duplicate
#          clinical records; the subscription holds the work until it returns).
# open   = keep processing and accept duplicate risk. Blocked in production
#          unless explicitly risk-accepted.
IDEMPOTENCY_FAIL_MODE=closed

# -----------------------------
# Quarantine (dead-letter sink for permanently-failed messages)
# -----------------------------
QUARANTINE_PATH=./data/quarantine.jsonl
# Keep false. True persists raw clinical payloads to disk, creating a second
# uncontrolled copy of PHI; validate_for_runtime() blocks it in production.
QUARANTINE_STORE_PAYLOAD=false

# GDPR Compliance Configuration
# Principle 3: Data Minimization
PATIENT_HASH_SALT=your-secure-production-salt-here

# Principle 5: Storage Limitation (in seconds)
SENSITIVE_DATA_TTL=3600           # 1 hour for processing
PROCESSED_EVENT_TTL=604800        # 7 days for analytics
AUDIT_LOG_TTL=7776000             # 90 days for compliance

# Principle 7: Accountability
LOG_LEVEL=INFO
AUDIT_LOG_DIR=./data/logs
DICOM_DATA_DIR=./data
DICOM_OUTPUT_PATH=./data/processed_dicom_events.jsonl
DICOM_AUDIT_PATH=./data/audit_log.jsonl

# Celery Configuration
CELERY_TASK_ALWAYS_EAGER=False
# Bounds how long POST /dicom/events may block on an unreachable broker before
# taking its fallback path. Keep well under any upstream HTTP timeout.
CELERY_BROKER_CONNECT_TIMEOUT=2.0

# API Configuration
API_HOST=0.0.0.0
API_PORT=8000
API_RELOAD=True
